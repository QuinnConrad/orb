spell call_bar() => void {
  evoke;
}

spell call_foo() => halfling {
  call_bar(); #cast spell w/o capture
  evoke 2.0;
}

spell fireball(shmungus level) => void {
  # gathering mana
  arcanum a;
  halfling b <= 4.0;
  mytype c <= b + call_foo(); #cast spell and capture.

  perhaps (c > 2.0) {
    call_bar();
  }
  otherwise {
    call_foo();
  }
}



# end
